{
  "name": "game_websocket",
  "description": "WebSocket client connect/disconnect/send messages",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Action: connect, disconnect, send, status"
      },
      "url": {
        "type": "string",
        "description": "WebSocket URL (for connect)"
      },
      "message": {
        "type": "string",
        "description": "Message to send (for send)"
      }
    },
    "required": [
      "action"
    ]
  }
}