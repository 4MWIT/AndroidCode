<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AIcode" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink_blue</item>
        <item name="colorPrimaryVariant">@color/ink_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/soft_teal</item>
        <item name="colorSecondaryVariant">@color/soft_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- System bars are part of the light Material You canvas, never purple. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
